@model IEnumerable<DDAC.Models.JobApplication>

@{
    ViewData["Title"] = "My Applications";
    var jobs = ViewBag.Jobs as List<DDAC.Models.JobVacancy>;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/JobSeeker/JobSeeker.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/JobSeeker/JobSeekerJobs.css"
          asp-append-version="true" />
}

<div class="jobseeker-page">

    <!-- Sidebar -->
    <partial name="~/Views/JobSeeker/_JobSeekerSidebar.cshtml" />

    <!-- Main Content -->
    <main class="jobseeker-main">

        <!-- Page Header -->
        <div class="page-header">
            <h1>My Applications</h1>

            <p>
                Track the jobs you have applied for and check the status
                of your applications.
            </p>
        </div>


        <!-- Application List -->
        <div class="content-list">

            @if (Model != null && Model.Any())
            {
                foreach (var application in Model)
                {
                    var job = jobs?.FirstOrDefault(j =>
                        j.JobID == application.JobID);

                    if (job == null)
                    {
                        continue;
                    }

                    <div class="list-card list-card-hover">

                        <!-- Application Header -->
                        <div class="list-card-header">

                            <div>

                                <h2 class="list-card-title">
                                    @job.JobTitle
                                </h2>

                                @if (!string.IsNullOrWhiteSpace(job.Location))
                                {
                                    <p class="list-card-subtitle">
                                        📍 @job.Location
                                    </p>
                                }

                            </div>

                            <!-- Application Status -->
                            @if (!string.IsNullOrWhiteSpace(application.Status))
                            {
                                <span class="tag tag-status">
                                    @application.Status
                                </span>
                            }

                        </div>


                        <!-- Job Description -->
                        <p class="description-text job-description">
                            @job.Description
                        </p>


                        <!-- Accessibility Features -->
                        @if (!string.IsNullOrWhiteSpace(job.AccessibilityFeatures))
                        {
                            <div class="job-accessibility-section">

                                <span class="job-label">
                                    Accessibility Features
                                </span>

                                <div class="tag-list">

                                    @foreach (var feature in job.AccessibilityFeatures
                                        .Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="tag">
                                            @feature.Trim()
                                        </span>
                                    }

                                </div>

                            </div>
                        }


                        <!-- Accommodations -->
                        @if (!string.IsNullOrWhiteSpace(job.AccommodationsAvailable))
                        {
                            <div class="job-accessibility-section">

                                <span class="job-label">
                                    Accommodations Available
                                </span>

                                <div class="tag-list">

                                    @foreach (var accommodation in job.AccommodationsAvailable
                                        .Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="tag">
                                            @accommodation.Trim()
                                        </span>
                                    }

                                </div>

                            </div>
                        }


                        <!-- Job Information -->
                        <div class="job-card-details">

                            <span class="detail-item">
                                <strong>Salary:</strong>
                                RM @job.Salary.ToString("N2")
                            </span>

                            <span class="detail-item">
                                <strong>Employment:</strong>
                                @job.EmploymentType
                            </span>

                        </div>


                        <!-- Footer -->
                        <div class="job-card-footer">

                            <span>
                                Applied:
                                @application.ApplicationDate.ToString("dd MMM yyyy")
                            </span>

                            <a asp-controller="JobSeeker"
                               asp-action="JobDetails"
                               asp-route-id="@job.JobID"
                               class="view-job">
                                View Job →
                            </a>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <h2>No Applications Yet</h2>

                    <p>
                        You haven't applied for any jobs yet.
                        Browse available jobs to find an opportunity
                        that interests you.
                    </p>

                    <br />

                    <a asp-controller="JobSeeker"
                       asp-action="BrowseJobs"
                       class="primary-button">
                        Browse Jobs
                    </a>

                </div>
            }

        </div>

    </main>

</div>