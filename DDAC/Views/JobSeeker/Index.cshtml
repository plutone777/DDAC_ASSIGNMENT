@{
    ViewData["Title"] = "Job Seeker";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/JobSeeker/JobSeeker.css"
          asp-append-version="true" />
}

<div class="jobseeker-page">

    <!-- Reusable Job Seeker Navigation -->
    <partial name="_JobSeekerSidebar" />

    <!-- Main Content -->
    <main class="jobseeker-main">

        <div class="welcome-section">

            <h1>Welcome, @Context.Session.GetString("FullName")</h1>

            <p>
                Find job opportunities, manage your profile,
                and keep track of your applications.
            </p>

        </div>

    </main>

</div>