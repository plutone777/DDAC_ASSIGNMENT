@model IEnumerable<DDAC.Models.CareerResource>

@{
    ViewData["Title"] = "Career Information";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/JobSeeker/JobSeeker.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/JobSeeker/JobSeekerJobs.css"
          asp-append-version="true" />
}

<div class="jobseeker-page">

    <partial name="~/Views/JobSeeker/_JobSeekerSidebar.cshtml" />

    <main class="jobseeker-main">

        <div class="page-header">
            <h1>Career Information</h1>

            <p>
                Explore useful resources to help you develop your career
                and prepare for your future.
            </p>
        </div>

        <div class="content-list">

            @if (Model != null && Model.Any())
            {
                foreach (var resource in Model)
                {
                    <div class="list-card">

                        <div class="list-card-header">

                            <div>
                                <h2 class="list-card-title">
                                    @resource.Title
                                </h2>
                            </div>

                            <span class="tag tag-status">
                                @resource.Category
                            </span>

                        </div>

                        <p class="description-text">
                            @resource.Description
                        </p>

                        <div class="job-card-footer">

                            <span>
                                Published
                                @resource.PublishedDate.ToString("dd MMM yyyy")
                            </span>

                            @if (!string.IsNullOrWhiteSpace(resource.ContentURL))
                            {
                                <a href="@resource.ContentURL"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="detail-item">
                                    View Resource →
                                </a>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-state">

                    <h2>No resources available</h2>

                    <p>
                        There are currently no career resources available.
                    </p>

                </div>
            }

        </div>

    </main>

</div>