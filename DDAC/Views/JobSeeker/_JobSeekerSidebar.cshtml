<aside class="jobseeker-sidebar">

    <div class="sidebar-user">
        <div class="sidebar-user-icon">
            @Context.Session.GetString("FullName")?.Substring(0, 1).ToUpper()
        </div>

        <div class="sidebar-user-info">
            <span class="sidebar-user-name">
                @Context.Session.GetString("FullName")
            </span>

            <span class="sidebar-user-role">
                Job Seeker
            </span>
        </div>
    </div>

    <nav class="sidebar-nav">

        <a asp-controller="JobSeekerProfile"
           asp-action="EditProfile"
           class="nav-button">
            Edit Profile
        </a>

        <a asp-controller="JobSeeker"
           asp-action="BrowseJobs"
           class="nav-button">
            Browse Jobs
        </a>

        <a asp-controller="JobSeeker"
           asp-action="MyApplications"
           class="nav-button">
            Track Applications
        </a>

        <a asp-controller="JobSeeker"
           asp-action="Information"
           class="nav-button">
            Get More Information
        </a>

        <a asp-controller="Inquiry"
           asp-action="CareerSupport"
           class="nav-button">
            Career Support
        </a>

        <a asp-controller="JobSeeker"
           asp-action="Announcements"
           class="nav-button">
            Announcements
        </a>

    </nav>

    <div class="sidebar-logout">

        <form asp-controller="User"
              asp-action="Logout"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="logout-button">
                Logout
            </button>

        </form>

    </div>

</aside>