@model List<EmployerProfile>

@{
    ViewData["Title"] = "Employer Verification";
    Layout = "_AdminLayout";
}

<div class="admin-panel" data-filter-scope>
    <div class="admin-toolbar">
        <input class="input" type="text" placeholder="Search company or industry" data-filter-input />
        <span style="margin-left:auto;font-size:13px;color:var(--color-neutral-700)"><span data-filter-count>@Model.Count</span> pending</span>
    </div>

    <div class="card elev-sm">
        @if (!Model.Any())
        {
            <div class="admin-empty">
                <p>Nothing in this view.</p>
                <p style="font-size:12px">Every employer has been dealt with. New registrations will appear here as "Pending".</p>
            </div>
        }
        else
        {
            <table class="table" data-filter-table>
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Industry</th>
                        <th>Address</th>
                        <th>Website</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employer in Model)
                    {
                        <tr style="cursor:pointer" data-search="@(employer.CompanyName + " " + employer.Industry)"
                            data-employer-link="@Url.Action("UserDetail", "Admin", new { id = employer.EmployerID, from = "verification" })">
                            <td><strong>@employer.CompanyName</strong></td>
                            <td>@employer.Industry</td>
                            <td>@employer.Address</td>
                            <td>@employer.Website</td>
                            <td style="text-align:right">
                                <form asp-controller="Admin" asp-action="ApproveEmployer" method="post">
                                    <input type="hidden" name="id" value="@employer.EmployerID" />
                                    <button type="submit" class="btn btn-primary">Approve</button>
                                </form>
                                <form asp-controller="Admin" asp-action="RejectEmployer" method="post">
                                    <input type="hidden" name="id" value="@employer.EmployerID" />
                                    <button type="submit" class="btn btn-danger">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="admin-empty" data-filter-empty style="display:none"><p>Nothing matches that.</p></div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('tr[data-employer-link]').forEach(function (row) {
            row.addEventListener('click', function (e) {
                if (e.target.closest('form')) return;
                window.location.href = row.getAttribute('data-employer-link');
            });
        });
    </script>
}