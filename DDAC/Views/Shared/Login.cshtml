@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Authentication.css"
          asp-append-version="true" />
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-header">
            <div class="website-name">Equal Hire</div>
            <h1>Welcome Back</h1>
        </div>

        <form asp-action="Login"
              method="post"
              class="auth-form">

            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label for="email">Email</label>

                <input id="email"
                       name="email"
                       type="email"
                       class="form-input"
                       placeholder="Enter your email"
                       required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>

                <input id="password"
                       name="password"
                       type="password"
                       class="form-input"
                       placeholder="Enter your password"
                       required />
            </div>

            <button type="submit"
                    class="auth-button">
                Login
            </button>

        </form>

        <div class="auth-footer">
            <p>
                Don't have an account?
                <a asp-action="Register">
                    Create an account
                </a>
            </p>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}