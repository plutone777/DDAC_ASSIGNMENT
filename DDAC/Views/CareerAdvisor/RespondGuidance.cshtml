@model DDAC.Models.CareerGuidance

@{
    ViewData["Title"] = "Respond to Guidance Request";
}

<link rel="stylesheet" href="~/css/CareerAdvisor/CareerAdvisor.css"/>

<div class="advisor-page">
    <partial name="_CareerAdvisorNav"/>

    <main class="advisor-main">

        <div class="page-header">
            <h1>Respond to guidance request</h1>
            <p>Your advice will be added to the request and the status set to completed</p>
        </div>

        <div class="content-card card-padding">
            <div class="detail-list">
                <div class="detail-item"><strong>Subject:</strong> @Model.Subject</div>
                <div class="detail-item"><strong>Type:</strong> @Model.GuidanceType</div>
                <div class="detail-item"><strong>Submitted:</strong> @Model.GuidanceDate.ToString("dd MMM yyyy")</div>
            </div>

            <div class="content-section">
                <span class="detail-label">Request</span>
                <p class="description-text">@Model.GuidanceNotes</p>
            </div>

            <form asp-action="RespondGuidance" method="post">
                <input type="hidden" name="id" value="@Model.GuidanceID"/>

                <div class="form-group">
                    <label for="response">Your advice</label>
                    <textarea name="response" id="response" class="form-input" rows="6" required></textarea>
                </div>

                <div class="action-area">
                    <a class="secondary-button" asp-action="GuidanceRequests">Cancel</a>
                    <button type="submit" class="primary-button">Send advice</button>
                </div>
            </form>

        </div>
    </main>
</div>