@model DDAC.Models.CareerResource
@{
    ViewData["Title"] = "Edit career resource";
}
<link rel="stylesheet" href="~/css/CareerAdvisor/CareerAdvisor.css"/>

<div class="advisor-page">
    <partial name="_CareerAdvisorNav"/>

    <main class="advisor-main">
        <div class="page-header">
            <h1>Edit career resource</h1>
            <p>Update the details of a published resource.</p>
        </div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ResourceID" />

            <div class="content-card card-padding">
                <div class="form-group">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-input" required />
                </div>

                <div class="form-group">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-input" rows="4" required></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="Category"></label>
                    <input asp-for="Category" class="form-input" required />
                </div>

                <div class="form-group">
                    <label asp-for="ContentURL"></label>
                    <input asp-for="ContentURL" class="form-input" type="url" required />
                </div>

                <div class="action-area">
                    <a class="secondary-button" asp-action="Index">Cancel</a>
                    <button type="submit" class="primary-button">Save</button>
                </div>
            </div>
        </form>
    </main>
</div>