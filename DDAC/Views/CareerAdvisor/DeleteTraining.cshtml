@model DDAC.Models.TrainingProgram
@{
    ViewData["Title"] = "Delete training program";
}
<link rel="stylesheet" href="~/css/CareerAdvisor/CareerAdvisor.css" />

<div class="advisor-page">
    <partial name="_CareerAdvisorNav" />

    <main class="advisor-main">
        <div class="page-header">
            <h1>Delete training program</h1>
            <p>This cannot be undone</p>
        </div>

        <div class="content-card card-padding">
            <div class="detail-list">
                <div class="detail-item"><strong>Title:</strong> @Model.Title</div>
                <div class="detail-item"><strong>Provider:</strong> @Model.Provider</div>
                <div class="detail-item"><strong>Eligibility:</strong> @Model.Eligibility</div>
            </div>

            <form asp-action="DeleteTrainingConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.TrainingID" />

                <div class="action-area">
                    <a class="secondary-button" asp-action="TrainingPrograms">Cancel</a>
                    <button type="submit" class="primary-button">Delete</button>
                </div>
            </form>
        </div>
    </main>
</div>