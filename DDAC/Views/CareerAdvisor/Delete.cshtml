@model DDAC.Models.CareerResource
@{
    ViewData["Title"] = "Delete career resource";
}
<link rel="stylesheet" href="~/css/CareerAdvisor/CareerAdvisor.css" />

<div class="advisor-page">
    <partial name="_CareerAdvisorNav" />

    <main class="advisor-main">
        <div class="page-header">
            <h1>Delete career resource</h1>
            <p>This cannot be undone</p>
        </div>

        <div class="content-card card-padding">
            <div class="detail-list">
                <div class="detail-item"><strong>Title:</strong> @Model.Title</div>
                <div class="detail-item"><strong>Category:</strong> @Model.Category</div>
                <div class="detail-item"><strong>Published:</strong> @Model.PublishedDate.ToString("dd MMM yyyy")</div>
            </div>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.ResourceID" />

                <div class="action-area">
                    <a class="secondary-button" asp-action="Index">Cancel</a>
                    <button type="submit" class="primary-button">Delete</button>
                </div>
            </form>
        </div>
    </main>
</div>