@model DDAC.Models.TrainingProgram
@{
    ViewData["Title"] = "Edit training program";
}
<link rel="stylesheet" href="~/css/CareerAdvisor/CareerAdvisor.css"/>

<div class="advisor-page">
    <partial name="_CareerAdvisorNav"/>

    <main class="advisor-main">
        <div class="page-header">
            <h1>Edit training program</h1>
            <p>Update the details of a program in the catalogue</p>
        </div>

        <form asp-action="EditTraining" method="post">
            <input type="hidden" asp-for="TrainingID" />

            <div class="content-card card-padding">
                <div class="form-group">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-input" required/>
                </div>

                <div class="form-group">
                    <label asp-for="Provider"></label>
                    <input asp-for="Provider" class="form-input" required/>
                </div>

                <div class="form-group">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-input" rows="4" required></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="Eligibility"></label>
                    <textarea asp-for="Eligibility" class="form-input" rows="3" required></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="URL"></label>
                    <input asp-for="URL" class="form-input" type="url" required/>
                </div>

                <div class="action-area">
                    <a class="secondary-button" asp-action="TrainingPrograms">Cancel</a>
                    <button type="submit" class="primary-button">Save</button>
                </div>

            </div>
        </form>
    </main>
</div>