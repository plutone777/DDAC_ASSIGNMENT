@model DDAC.Models.CareerRecommendation
@{
    ViewData["Title"] = "Delete recommendation";
}
<link rel="stylesheet" href="~/css/CareerAdvisor/CareerAdvisor.css" />

<div class="advisor-page">
    <partial name="_CareerAdvisorNav" />

    <main class="advisor-main">
        <div class="page-header">
            <h1>Delete recommendation</h1>
            <p>This cannot be undone</p>
        </div>

        <div class="content-card card-padding">
            <div class="detail-list">
                <div class="detail-item"><strong>Program:</strong> @Model.Title</div>
                <div class="detail-item"><strong>Type:</strong> @Model.RecommendationType</div>
                <div class="detail-item"><strong>Reason:</strong> @Model.Reason</div>
                <div class="detail-item"><strong>Sent:</strong> @Model.DateCreated.ToString("dd MMM yyyy")</div>
            </div>

            <form asp-action="DeleteRecommendationConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.RecommendationID" />

                <div class="action-area">
                    <a class="secondary-button" asp-action="Recommendations">Cancel</a>
                    <button type="submit" class="primary-button">Delete</button>
                </div>
            </form>
        </div>
    </main>
</div>