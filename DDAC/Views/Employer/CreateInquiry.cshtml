@model Inquiry
@{ ViewData["Title"] = "Create Inquiry"; }
@section Styles { <link rel="stylesheet" href="~/css/Employer/employer.css" asp-append-version="true" /> }

<div class="employer-shell"><partial name="_EmployerSidebar" /><section class="employer-content">
    <div class="employer-page-heading"><div><span class="employer-eyebrow">Expert support</span><h1>New advisor inquiry</h1><p>Provide enough context for the advisor to give useful guidance.</p></div></div>
    <form asp-action="CreateInquiry" method="post" class="employer-panel employer-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-12"><label asp-for="AdvisorID" class="form-label">Career advisor</label><select asp-for="AdvisorID" asp-items="ViewBag.AdvisorOptions" class="form-select"><option value="">Select an advisor</option></select><span asp-validation-for="AdvisorID" class="text-danger"></span></div><div class="col-12"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-12"><label asp-for="Message" class="form-label"></label><textarea asp-for="Message" rows="8" class="form-control"></textarea><span asp-validation-for="Message" class="text-danger"></span></div></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Send inquiry</button><a class="btn btn-outline-secondary" asp-action="Inquiries">Cancel</a></div></form>
</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

