@model JobVacancy
@{ ViewData["Title"] = "Edit Vacancy"; }
@section Styles { <link rel="stylesheet" href="~/css/Employer/employer.css" asp-append-version="true" /> }

<div class="employer-shell"><partial name="_EmployerSidebar" /><section class="employer-content">
    <div class="employer-page-heading"><div><span class="employer-eyebrow">Vacancy @Model.JobID</span><h1>Edit vacancy</h1><p>Changes are visible to job seekers when the vacancy is published.</p></div></div>
    <partial name="_VacancyForm" model="Model" />
</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
