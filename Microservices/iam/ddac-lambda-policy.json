{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReportStorage",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::ddac-admin-reports-221181440679",
        "arn:aws:s3:::ddac-admin-reports-221181440679/*"
      ]
    },
    {
      "Sid": "Notifications",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:us-east-1:221181440679:ddac-admin-notifications"
    },
    {
      "Sid": "ReportQueueProducer",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:sqs:us-east-1:221181440679:ddac-report-queue"
    },
    {
      "Sid": "ReportQueueConsumer",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:221181440679:ddac-report-queue"
    },
    {
      "Sid": "Logging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:221181440679:*"
    },
    {
      "Sid": "Tracing",
      "Effect": "Allow",
      "Action": [
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": "*"
    }
  ]
}
